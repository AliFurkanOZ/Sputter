<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!--
  ISA-101 high-performance HMI palette.
  Neutral grays carry the normal process picture; saturated color is reserved
  for alarm priorities. Equipment state is shown by fill (dark = on/open,
  hollow = off/closed), not by red/green.
 -->
 <Color x:Key="ScreenColor">#D7DADD</Color>
 <SolidColorBrush x:Key="ScreenBrush" Color="{StaticResource ScreenColor}"/>
 <SolidColorBrush x:Key="PanelBrush" Color="#E8EAEC"/>
 <SolidColorBrush x:Key="PanelHeaderBrush" Color="#CDD1D5"/>
 <SolidColorBrush x:Key="PanelBorderBrush" Color="#A3AAB1"/>
 <SolidColorBrush x:Key="DividerBrush" Color="#C3C8CD"/>
 <SolidColorBrush x:Key="InsetBrush" Color="#F4F5F6"/>
 <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="InputBorderBrush" Color="#858D95"/>
 <SolidColorBrush x:Key="InkBrush" Color="#1C2126"/>
 <SolidColorBrush x:Key="LabelBrush" Color="#4F5860"/>
 <SolidColorBrush x:Key="FaintBrush" Color="#566576"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#2D5B88"/>
 <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A6C9C"/>
 <SolidColorBrush x:Key="AccentLightBrush" Color="#C9D7E6"/>
 <SolidColorBrush x:Key="EquipOnBrush" Color="#3B434B"/>
 <SolidColorBrush x:Key="EquipOffBrush" Color="#F4F5F6"/>
 <SolidColorBrush x:Key="ButtonBrush" Color="#D2D6DA"/>
 <SolidColorBrush x:Key="ButtonHoverBrush" Color="#DEE1E4"/>
 <SolidColorBrush x:Key="ButtonPressedBrush" Color="#BFC4C9"/>
 <SolidColorBrush x:Key="TopBarBrush" Color="#2A2F34"/>
 <SolidColorBrush x:Key="NavBrush" Color="#353B41"/>
 <SolidColorBrush x:Key="NavHoverBrush" Color="#434A51"/>
 <SolidColorBrush x:Key="NavTextBrush" Color="#D3D7DB"/>
 <SolidColorBrush x:Key="TopBarTextBrush" Color="#E6E9EC"/>
 <SolidColorBrush x:Key="TopBarMutedBrush" Color="#9AA3AC"/>
 <!-- Alarm priorities (ISA-18.2 / ISA-101): 1 critical, 2 high, 3 medium, 4 diagnostic. -->
 <SolidColorBrush x:Key="Alarm1Brush" Color="#D6241C"/>
 <SolidColorBrush x:Key="Alarm2Brush" Color="#F07F00"/>
 <SolidColorBrush x:Key="Alarm3Brush" Color="#F0CF00"/>
 <SolidColorBrush x:Key="Alarm4Brush" Color="#8E44AD"/>
 <SolidColorBrush x:Key="AlarmBannerBrush" Color="#FBE7CC"/>

 <!-- Base -->
 <Style x:Key="AppWindow" TargetType="Window">
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="Background" Value="{StaticResource ScreenBrush}"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>

 <!-- Typography -->
 <Style x:Key="PageTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="20"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="PageSubtitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  <Setter Property="Margin" Value="0,2,0,0"/>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
 </Style>
 <Style x:Key="CapsLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="HelpText" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="ValueText" TargetType="TextBlock">
  <Setter Property="FontSize" Value="26"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
 </Style>
 <Style x:Key="UnitText" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  <Setter Property="Margin" Value="5,0,0,4"/>
  <Setter Property="VerticalAlignment" Value="Bottom"/>
 </Style>
 <Style x:Key="MonoText" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="Consolas"/>
  <Setter Property="FontSize" Value="13"/>
 </Style>
 <!-- Backwards-compatible alias used by the smaller dialogs. -->
 <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>

 <!-- Surfaces -->
 <Style x:Key="Panel" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="2"/>
  <Setter Property="Padding" Value="12"/>
 </Style>
 <!-- Read-only process value field: recessed, never white like an input. -->
 <Style x:Key="Inset" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="2"/>
  <Setter Property="Padding" Value="10,6"/>
 </Style>
 <Style x:Key="Divider" TargetType="Border">
  <Setter Property="Height" Value="1"/>
  <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
  <Setter Property="Margin" Value="0,10"/>
 </Style>
 <!-- Guidance box: tells the operator what happens now / what to do next. -->
 <Style x:Key="HintBox" TargetType="Border">
  <Setter Property="Background" Value="#E3EAF2"/>
  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
  <Setter Property="BorderThickness" Value="4,0,0,0"/>
  <Setter Property="Padding" Value="12,8"/>
 </Style>
 <Style TargetType="GroupBox">
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="GroupBox">
     <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">
      <DockPanel>
       <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0" Height="34">
        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="15">
         <ContentPresenter.Resources>
          <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
         </ContentPresenter.Resources>
        </ContentPresenter>
       </Border>
       <ContentPresenter Margin="12"/>
      </DockPanel>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Buttons -->
 <Style TargetType="Button">
  <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="16,0"/>
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="MinWidth" Value="80"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonPressedBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
  <Setter Property="BorderBrush" Value="#1F4468"/>
  <Setter Property="Foreground" Value="White"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#0E2A45"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Stop / abort action: dark neutral, red stays reserved for alarms. -->
 <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
  <Setter Property="Background" Value="{StaticResource EquipOnBrush}"/>
  <Setter Property="BorderBrush" Value="#1C2126"/>
 </Style>
 <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="MinWidth" Value="0"/>
  <Setter Property="MinHeight" Value="30"/>
  <Setter Property="Padding" Value="12,0"/>
  <Setter Property="FontSize" Value="13"/>
 </Style>
 <!-- Buttons on the dark top bar. -->
 <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Background" Value="#3A4148"/>
  <Setter Property="BorderBrush" Value="#59616A"/>
  <Setter Property="Foreground" Value="{StaticResource TopBarTextBrush}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#4A525A"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Segmented selector (trend range etc.). -->
 <Style x:Key="SegmentButton" TargetType="RadioButton">
  <Setter Property="MinHeight" Value="30"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="BorderThickness" Value="1,1,0,1"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border x:Name="Chrome" Background="{StaticResource ButtonBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource EquipOnBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!--
  Equipment toggle: square lamp + name + state text.
  Checked = on/open (dark fill), unchecked = off/closed (hollow).
 -->
 <Style x:Key="DeviceToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="MinHeight" Value="42"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Chrome" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,0">
      <DockPanel>
       <Rectangle x:Name="Lamp" DockPanel.Dock="Left" Width="14" Height="14" Fill="{StaticResource EquipOffBrush}" Stroke="{StaticResource EquipOnBrush}" StrokeThickness="2" Margin="0,0,10,0" VerticalAlignment="Center"/>
       <TextBlock x:Name="State" DockPanel.Dock="Right" Text="KAPALI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}" Margin="8,0,0,0"/>
       <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="15">
        <ContentPresenter.Resources>
         <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        </ContentPresenter.Resources>
       </ContentPresenter>
      </DockPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Lamp" Property="Fill" Value="{StaticResource EquipOnBrush}"/><Setter TargetName="State" Property="Text" Value="AÇIK"/><Setter TargetName="State" Property="Foreground" Value="{StaticResource InkBrush}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PanelBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DividerBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Static state indicator for read-only status lists. Tag="On" fills the lamp. -->
 <Style x:Key="StateLamp" TargetType="Rectangle">
  <Setter Property="Width" Value="12"/>
  <Setter Property="Height" Value="12"/>
  <Setter Property="Fill" Value="{StaticResource EquipOffBrush}"/>
  <Setter Property="Stroke" Value="{StaticResource EquipOnBrush}"/>
  <Setter Property="StrokeThickness" Value="2"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Style.Triggers>
   <Trigger Property="Tag" Value="On"><Setter Property="Fill" Value="{StaticResource EquipOnBrush}"/></Trigger>
  </Style.Triggers>
 </Style>

 <!-- Inputs: white = operator-editable setpoint. -->
 <Style TargetType="TextBox">
  <Setter Property="Background" Value="{StaticResource InputBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="6,0"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FontSize" Value="14"/>
  <Style.Triggers>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
   <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{StaticResource InsetBrush}"/><Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="TextAlignment" Value="Right"/>
  <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="Padding" Value="8,4"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FontSize" Value="14"/>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FontSize" Value="13"/>
 </Style>

 <!-- Tables -->
 <Style TargetType="DataGrid">
  <Setter Property="AutoGenerateColumns" Value="False"/>
  <Setter Property="CanUserAddRows" Value="False"/>
  <Setter Property="CanUserResizeRows" Value="False"/>
  <Setter Property="IsReadOnly" Value="True"/>
  <Setter Property="HeadersVisibility" Value="Column"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
  <Setter Property="RowBackground" Value="{StaticResource InputBrush}"/>
  <Setter Property="AlternatingRowBackground" Value="{StaticResource InsetBrush}"/>
  <Setter Property="RowHeight" Value="32"/>
  <Setter Property="ColumnHeaderHeight" Value="32"/>
  <Setter Property="SelectionMode" Value="Single"/>
  <Setter Property="SelectionUnit" Value="FullRow"/>
  <Setter Property="FontSize" Value="14"/>
 </Style>
 <Style TargetType="DataGridColumnHeader">
  <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}"/>
  <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Padding" Value="8,0"/>
  <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
  <Setter Property="BorderThickness" Value="0,0,1,1"/>
 </Style>
 <Style TargetType="DataGridCell">
  <Setter Property="Padding" Value="8,0"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentLightBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Trigger>
  </Style.Triggers>
 </Style>

 <!-- Horizontal page tabs follow the WinForms page order. -->
 <Style x:Key="NavigationTab" TargetType="TabItem">
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabItem">
    <Border x:Name="Chrome" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="24,11" Margin="0,0,5,0">
     <ContentPresenter x:Name="TabCaption" ContentSource="Header"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PanelBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="TabCaption" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2,2,2,0"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <!-- In-page section tabs (underline style). -->
 <Style x:Key="SubTab" TargetType="TabItem">
  <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="16,8" Margin="0,0,4,-1" Cursor="Hand">
     <ContentPresenter ContentSource="Header"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource PanelBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="SubTabs" TargetType="TabControl">
  <Setter Property="ItemContainerStyle" Value="{StaticResource SubTab}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabControl">
    <DockPanel>
     <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
      <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
     </Border>
     <ContentPresenter ContentSource="SelectedContent"/>
    </DockPanel>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="NavigationTabs" TargetType="TabControl">
  <Setter Property="TabStripPlacement" Value="Top"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationTab}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabControl">
    <DockPanel>
     <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,0">
      <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
     </Border>
     <ContentPresenter ContentSource="SelectedContent" Margin="12"/>
    </DockPanel>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
</ResourceDictionary>
