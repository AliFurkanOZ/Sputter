<Window x:Class="SputterControlApp.Wpf.Views.TargetWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Target seçimi — Örnek veriler" Style="{StaticResource AppWindow}" Width="740" Height="480" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="Vazgeç" IsCancel="True"/>
     <Button Content="Seç" Click="SelectTarget" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="100" Margin="0"/>
    </StackPanel>
    <TextBlock Text="Target seçimi" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
   </DockPanel>
  </Border>
  <GroupBox Header="Target listesi" Margin="20,16">
   <DataGrid x:Name="Targets" ItemsSource="{Binding Targets}" SelectedIndex="0">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="*"/>
     <DataGridTextColumn Header="Kullanılan ömür (Wh)" Binding="{Binding UsedWh}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </GroupBox>
 </DockPanel>
</Window>
