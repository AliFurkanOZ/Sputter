<Window x:Class="SputterControlApp.Wpf.Views.ManualReadWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Manuel register okuma — Arayüz önizlemesi" Style="{StaticResource AppWindow}" Width="720" Height="600" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterOwner">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Kapat" Click="CloseWindow" IsCancel="True" Margin="0"/>
    <TextBlock Text="Modbus servisi bağlı değildir." Style="{StaticResource FieldLabel}"/>
   </DockPanel>
  </Border>
  <Grid Margin="20,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <GroupBox Header="Okuma parametreleri" Margin="0,0,0,12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
     <TextBlock Text="Başlangıç adresi" Style="{StaticResource FieldLabel}"/>
     <TextBox Grid.Column="1" Text="0" Style="{StaticResource NumericInput}"/>
     <TextBlock Grid.Column="3" Text="Adet" Style="{StaticResource FieldLabel}"/>
     <TextBox Grid.Column="4" Text="2" Style="{StaticResource NumericInput}"/>
     <TextBlock Grid.Row="1" Text="Veri tipi" Style="{StaticResource FieldLabel}"/>
     <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="UInt16"/><ComboBoxItem Content="Int16"/><ComboBoxItem Content="Float32"/></ComboBox>
     <TextBlock Grid.Row="1" Grid.Column="3" Text="Byte sırası" Style="{StaticResource FieldLabel}"/>
     <ComboBox Grid.Row="1" Grid.Column="4" SelectedIndex="0"><ComboBoxItem Content="Big endian"/><ComboBoxItem Content="Little endian"/></ComboBox>
     <TextBlock Grid.Row="2" Text="Word sırası" Style="{StaticResource FieldLabel}"/>
     <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="High word first"/><ComboBoxItem Content="Low word first"/></ComboBox>
     <Button Grid.Row="2" Grid.Column="4" Content="Register oku" IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Center"/>
    </Grid>
   </GroupBox>
   <GroupBox Grid.Row="1" Header="Sonuç">
    <TextBox IsReadOnly="True" Text="—" FontFamily="Consolas" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6"/>
   </GroupBox>
  </Grid>
 </DockPanel>
</Window>
