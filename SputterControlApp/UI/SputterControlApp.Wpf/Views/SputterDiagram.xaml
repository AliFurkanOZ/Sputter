<UserControl x:Class="SputterControlApp.Wpf.Views.SputterDiagram"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:SputterControlApp.Wpf.Controls">
 <!--
  Vector chamber layout. Readbacks are supplied by WorkspaceState; no service access. -->
 <UserControl.Resources>
  <SolidColorBrush x:Key="Vessel" Color="#D3D7DB"/>
  <SolidColorBrush x:Key="Outline" Color="#5F6870"/>
  <SolidColorBrush x:Key="On" Color="#C5CFD8"/>
  <SolidColorBrush x:Key="Off" Color="#F4F5F6"/>
  <Style x:Key="ValveShape" TargetType="Path">
   <Setter Property="Fill" Value="#DDE1E5"/><Setter Property="Stroke" Value="#5F6870"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeDashArray" Value="2,1"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Fill" Value="#3B434B"/><Setter Property="StrokeDashArray" Value="{x:Null}"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False"><Setter Property="Fill" Value="#F4F5F6"/><Setter Property="StrokeDashArray" Value="{x:Null}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Pipe" TargetType="Path"><Setter Property="Stroke" Value="#7A838B"/><Setter Property="StrokeThickness" Value="12"/><Setter Property="StrokeLineJoin" Value="Miter"/></Style>
  <Style x:Key="PipeInner" TargetType="Path"><Setter Property="Stroke" Value="#DADDE0"/><Setter Property="StrokeThickness" Value="6"/><Setter Property="StrokeLineJoin" Value="Miter"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#4F5860"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="StateCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="#1C2126"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="DiagramLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#1C2126"/></Style>
  <Style x:Key="ValueBox" TargetType="Border"><Setter Property="Background" Value="#F4F5F6"/><Setter Property="BorderBrush" Value="#A3AAB1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,3"/></Style>
 </UserControl.Resources>
 <Viewbox Stretch="Uniform">
  <Canvas Width="1100" Height="555">

   <!-- Process chamber -->
   <Path Fill="{StaticResource Vessel}" Stroke="{StaticResource Outline}" StrokeThickness="3" Data="M 384,146 L 448,146 L 448,116 L 705,116 L 705,145 L 760,145 L 760,360 L 720,360 L 720,390 L 404,390 L 404,330 L 384,330 Z"/>
   <TextBlock Canvas.Left="500" Canvas.Top="262" Text="PROSES HAZNESİ" FontSize="13" FontWeight="SemiBold" Foreground="#4F5860"/>
   <Border Canvas.Left="503" Canvas.Top="284" Style="{StaticResource ValueBox}"><TextBlock Text="{Binding State.Pressure, StringFormat='{}{0} Torr'}" FontSize="15" FontWeight="SemiBold" Foreground="#1C2126"/></Border>

   <!-- Load lock / transfer rod -->
   <Rectangle Canvas.Left="80" Canvas.Top="168" Width="305" Height="65" Fill="{StaticResource Vessel}" Stroke="{StaticResource Outline}" StrokeThickness="3"/>
   <Rectangle Canvas.Left="67" Canvas.Top="155" Width="14" Height="91" Fill="#A3AAB1" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <Path Stroke="#5F6870" StrokeThickness="6" Data="M 74,193 L 346,193"/>
   <TextBlock Canvas.Left="119" Canvas.Top="131" Text="LOAD LOCK / TRANSFER" Style="{StaticResource DiagramLabel}"/>
   <!-- Transfer valve: status comes only from its readback. -->
   <Rectangle Canvas.Left="374" Canvas.Top="151" Width="19" Height="100" Fill="{StaticResource Off}" Stroke="{StaticResource On}" StrokeThickness="3"/>
   <TextBlock Canvas.Left="320" Canvas.Top="244" Text="Transfer kapağı" Style="{StaticResource Caption}"/>
   <c:ValveIndicator Canvas.Left="310" Canvas.Top="265" IsOpen="{Binding State.TransferValve.IsOpen}"/>

   <!-- Substrate holder, shaft, rotation and heating -->
   <Path Style="{StaticResource Pipe}" Data="M 565,116 L 565,65 L 629,65 L 629,52"/>
   <Path Style="{StaticResource PipeInner}" Data="M 565,116 L 565,65 L 629,65 L 629,52"/>
   <Rectangle Canvas.Left="560" Canvas.Top="116" Width="10" Height="73" Fill="#8C949C" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <Rectangle Canvas.Left="508" Canvas.Top="186" Width="115" Height="18" Fill="#8C949C" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <Path Stroke="#D3D7DB" StrokeThickness="2" Data="M 511,188 L 526,201 L 541,188 L 556,201 L 571,188 L 586,201 L 601,188 L 616,201"/>
   <Rectangle Canvas.Left="522" Canvas.Top="215" Width="87" Height="10" Fill="#F4F5F6" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <TextBlock Canvas.Left="646" Canvas.Top="186" Text="Substrat" Style="{StaticResource DiagramLabel}"/>
   <Border Canvas.Left="646" Canvas.Top="206" Style="{StaticResource ValueBox}"><TextBlock Text="{Binding State.HeaterRead, StringFormat='{}{0} °C'}" FontSize="12" FontWeight="SemiBold"/></Border>
   <Path Stroke="#A3AAB1" StrokeThickness="1" Data="M 610,220 L 640,220"/>
   <Ellipse Canvas.Left="548" Canvas.Top="22" Width="34" Height="34" Fill="{StaticResource Off}" Stroke="{StaticResource On}" StrokeThickness="2"/>
   <TextBlock Canvas.Left="558" Canvas.Top="29" Text="M" FontWeight="Bold"/>
   <Ellipse Canvas.Left="612" Canvas.Top="22" Width="34" Height="34" Fill="{StaticResource Off}" Stroke="{StaticResource On}" StrokeThickness="2"/>
   <TextBlock Canvas.Left="622" Canvas.Top="29" Text="H" FontWeight="Bold"/>
   <TextBlock Canvas.Left="476" Canvas.Top="31" Text="Rotasyon" Style="{StaticResource Caption}"/>
   <TextBlock Canvas.Left="654" Canvas.Top="31" Text="Isıtıcı" Style="{StaticResource Caption}"/>

   <!-- Three magnetron sources and tilted feedthroughs -->
   <Path Stroke="#5F6870" StrokeThickness="14" Data="M 463,475 L 463,357 L 475,327 M 565,475 L 565,355 M 666,475 L 666,357 L 654,327"/>
   <Path Stroke="#C3C8CD" StrokeThickness="6" Data="M 463,475 L 463,357 L 475,327 M 565,475 L 565,355 M 666,475 L 666,357 L 654,327"/>
   <Rectangle Canvas.Left="451" Canvas.Top="318" Width="49" Height="24" Fill="#A3AAB1" Stroke="{StaticResource Outline}" StrokeThickness="2"><Rectangle.RenderTransform><RotateTransform Angle="20" CenterX="24" CenterY="12"/></Rectangle.RenderTransform></Rectangle>
   <Rectangle Canvas.Left="540" Canvas.Top="335" Width="50" Height="24" Fill="#A3AAB1" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <Rectangle Canvas.Left="629" Canvas.Top="318" Width="49" Height="24" Fill="#A3AAB1" Stroke="{StaticResource Outline}" StrokeThickness="2"><Rectangle.RenderTransform><RotateTransform Angle="-20" CenterX="24" CenterY="12"/></Rectangle.RenderTransform></Rectangle>
   <!-- Shutter geometry is illustrative, not a live position indicator. -->
   <Path Stroke="{StaticResource On}" StrokeThickness="2" Fill="{StaticResource Off}" Data="M 449,307 L 503,326 L 501,331 L 447,312 Z M 539,326 L 591,326 L 591,331 L 539,331 Z M 627,326 L 681,307 L 683,312 L 629,331 Z"/>
   <Border Canvas.Left="420" Canvas.Top="485" Width="86" Background="#F4F5F6" BorderBrush="#A3AAB1" BorderThickness="1" Padding="6,5"><StackPanel><TextBlock Text="RF1" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding State.Rf1.Target}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border>
   <Border Canvas.Left="522" Canvas.Top="485" Width="86" Background="#F4F5F6" BorderBrush="#A3AAB1" BorderThickness="1" Padding="6,5"><StackPanel><TextBlock Text="DC" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding State.Dc.Target}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border>
   <Border Canvas.Left="623" Canvas.Top="485" Width="86" Background="#F4F5F6" BorderBrush="#A3AAB1" BorderThickness="1" Padding="6,5"><StackPanel><TextBlock Text="RF2" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding State.Rf2.Target}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border>

   <!-- QCM sensors -->
   <Ellipse Canvas.Left="491" Canvas.Top="351" Width="20" Height="20" Fill="#F4F5F6" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <Path Stroke="{StaticResource Outline}" StrokeThickness="3" Data="M 494,364 L 508,364 M 501,365 L 501,386"/>
   <Ellipse Canvas.Left="618" Canvas.Top="351" Width="20" Height="20" Fill="#F4F5F6" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <Path Stroke="{StaticResource Outline}" StrokeThickness="3" Data="M 621,364 L 635,364 M 628,365 L 628,386"/>
   <TextBlock Canvas.Left="744" Canvas.Top="421" Text="QCM sensörleri" Style="{StaticResource Caption}"/>
   <Path Stroke="#A3AAB1" StrokeThickness="1" Data="M 633,366 L 710,412 L 738,428"/>

   <!-- Left roughing branch; no assumed valve or pump state. -->
   <Path Style="{StaticResource Pipe}" Data="M 285,233 L 285,334 L 176,334 L 176,388"/>
   <Path Style="{StaticResource PipeInner}" Data="M 285,233 L 285,334 L 176,334 L 176,388"/>
   <Path Style="{StaticResource ValveShape}" Tag="{Binding State.RoughingValve.IsOpen}" StrokeLineJoin="Round" Data="M 271,268 L 299,268 L 285,286 Z M 271,304 L 299,304 L 285,286 Z"/>
   <TextBlock Canvas.Left="147" Canvas.Top="264" Text="V1 roughing" Style="{StaticResource Caption}"/>
   <c:ValveIndicator Canvas.Left="147" Canvas.Top="284" IsOpen="{Binding State.RoughingValve.IsOpen}"/>
   <Ellipse Canvas.Left="147" Canvas.Top="384" Width="59" Height="59" Fill="{StaticResource On}" Stroke="{StaticResource On}" StrokeThickness="3"/>
   <Path Stroke="#F4F5F6" StrokeThickness="2" Data="M 160,398 L 194,398 L 177,429 Z"/>
   <TextBlock Canvas.Left="118" Canvas.Top="452" Text="SCROLL POMPA" Style="{StaticResource DiagramLabel}"/>
   <TextBlock Canvas.Left="139" Canvas.Top="472" Text="—" Style="{StaticResource StateCaption}"/>

   <!-- Right high-vacuum line; valve symbols follow their explicit status. -->
   <Path Style="{StaticResource Pipe}" Data="M 760,183 L 916,183 L 916,300 L 974,300 L 974,368 M 760,306 L 974,306"/>
   <Path Style="{StaticResource PipeInner}" Data="M 760,183 L 916,183 L 916,300 L 974,300 L 974,368 M 760,306 L 974,306"/>
   <Path Style="{StaticResource ValveShape}" Tag="{Binding State.GateValve.IsOpen}" StrokeLineJoin="Round" Data="M 822,169 L 822,197 L 840,183 Z M 858,169 L 858,197 L 840,183 Z"/>
   <TextBlock Canvas.Left="790" Canvas.Top="206" Text="V2 gate valve" Style="{StaticResource Caption}"/>
   <c:ValveIndicator Canvas.Left="790" Canvas.Top="226" IsOpen="{Binding State.GateValve.IsOpen}"/>
   <Path Style="{StaticResource ValveShape}" Tag="{Binding State.BypassValve.IsOpen}" StrokeLineJoin="Round" Data="M 822,292 L 822,320 L 840,306 Z M 858,292 L 858,320 L 840,306 Z"/>
   <TextBlock Canvas.Left="800" Canvas.Top="329" Text="V3 bypass" Style="{StaticResource Caption}"/>
   <c:ValveIndicator Canvas.Left="800" Canvas.Top="349" IsOpen="{Binding State.BypassValve.IsOpen}"/>
   <Ellipse Canvas.Left="944" Canvas.Top="365" Width="60" Height="60" Fill="{StaticResource On}" Stroke="{StaticResource On}" StrokeThickness="3"/>
   <Path Stroke="#F4F5F6" StrokeThickness="2" Data="M 958,378 L 990,378 L 974,411 Z"/>
   <TextBlock Canvas.Left="926" Canvas.Top="434" Text="TURBO POMPA" Style="{StaticResource DiagramLabel}"/>
   <TextBlock Canvas.Left="918" Canvas.Top="454" Text="{Binding State.TurboFrequency, StringFormat='{}{0} Hz'}" Style="{StaticResource StateCaption}"/>

   <!-- Vent and pressure gauges -->
   <Path Style="{StaticResource Pipe}" Data="M 758,269 L 1031,269 L 1031,217 M 327,168 L 327,100 M 705,123 L 759,123 L 759,80"/>
   <Path Style="{StaticResource PipeInner}" Data="M 758,269 L 1031,269 L 1031,217 M 327,168 L 327,100 M 705,123 L 759,123 L 759,80"/>
   <Ellipse Canvas.Left="311" Canvas.Top="70" Width="32" Height="32" Fill="{StaticResource Off}" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <TextBlock Canvas.Left="322" Canvas.Top="77" Text="P" FontWeight="Bold"/>
   <TextBlock Canvas.Left="204" Canvas.Top="70" Text="Hazne basıncı" Style="{StaticResource Caption}"/>
   <Border Canvas.Left="204" Canvas.Top="86" Style="{StaticResource ValueBox}" Padding="5,1"><TextBlock Text="{Binding State.Pressure, StringFormat='{}{0} Torr'}" FontSize="11" FontWeight="SemiBold"/></Border>
   <Ellipse Canvas.Left="743" Canvas.Top="50" Width="32" Height="32" Fill="{StaticResource Off}" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
   <TextBlock Canvas.Left="754" Canvas.Top="57" Text="P" FontWeight="Bold"/>
   <TextBlock Canvas.Left="785" Canvas.Top="50" Text="Proses basıncı" Style="{StaticResource Caption}"/>
   <Border Canvas.Left="785" Canvas.Top="66" Style="{StaticResource ValueBox}" Padding="5,1"><TextBlock Text="{Binding State.Capacitance, StringFormat='{}{0} Torr'}" FontSize="11" FontWeight="SemiBold"/></Border>
   <Path Style="{StaticResource ValveShape}" Tag="{Binding State.VentValve.IsOpen}" StrokeLineJoin="Round" Data="M 1017,185 L 1045,185 L 1031,203 Z M 1017,221 L 1045,221 L 1031,203 Z"/>
   <TextBlock Canvas.Left="974" Canvas.Top="120" Text="V4 vent" Style="{StaticResource Caption}"/>
   <c:ValveIndicator Canvas.Left="974" Canvas.Top="140" IsOpen="{Binding State.VentValve.IsOpen}"/>

  </Canvas>
 </Viewbox>
</UserControl>
