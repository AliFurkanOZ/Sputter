<UserControl x:Class="SputterNewApp.Controls.ValueReadout" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Process value: caps label, large tabular value with unit, optional note line. -->
 <StackPanel>
  <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource CapsLabel}" TextTrimming="CharacterEllipsis"/>
  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
   <TextBlock Text="{Binding Value, ElementName=Root}" Style="{StaticResource ValueText}" FontSize="{Binding ValueSize, ElementName=Root}"/>
   <TextBlock Text="{Binding Unit, ElementName=Root}" Style="{StaticResource UnitText}"/>
  </StackPanel>
  <TextBlock x:Name="NoteText" Text="{Binding Note, ElementName=Root}" Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
 </StackPanel>
</UserControl>
