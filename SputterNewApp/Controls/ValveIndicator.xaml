<UserControl x:Class="SputterNewApp.Controls.ValveIndicator"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="Root" MinWidth="120" MinHeight="28" VerticalAlignment="Center"
 AutomationProperties.Name="{Binding Text, ElementName=StateText}">
 <Border x:Name="Chrome" BorderThickness="1" CornerRadius="2" Padding="7,4">
  <Border.Style>
   <Style TargetType="Border">
    <Setter Property="Background" Value="#DDE1E5"/>
    <Setter Property="BorderBrush" Value="#858D95"/>
    <Setter Property="ToolTip" Value="Valf konumu bilinmiyor; cihazdan durum bilgisi alınmadı."/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="True">
      <Setter Property="Background" Value="#3B434B"/>
      <Setter Property="ToolTip" Value="Valf açık. Bu gösterge mevcut konumu gösterir; komut düğmesi değildir."/>
     </DataTrigger>
     <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="False">
      <Setter Property="Background" Value="#F4F5F6"/>
      <Setter Property="ToolTip" Value="Valf kapalı. Bu gösterge mevcut konumu gösterir; komut düğmesi değildir."/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
  </Border.Style>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock FontSize="15" FontWeight="Bold" HorizontalAlignment="Left">
    <TextBlock.Style><Style TargetType="TextBlock">
     <Setter Property="Text" Value="?"/><Setter Property="Foreground" Value="#38424C"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="True"><Setter Property="Text" Value="●"/><Setter Property="Foreground" Value="White"/></DataTrigger>
      <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="False"><Setter Property="Text" Value="○"/><Setter Property="Foreground" Value="#1C2126"/></DataTrigger>
     </Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
   <TextBlock x:Name="StateText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock.Style><Style TargetType="TextBlock">
     <Setter Property="Text" Value="BİLİNMİYOR"/><Setter Property="Foreground" Value="#38424C"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="True"><Setter Property="Text" Value="AÇIK"/><Setter Property="Foreground" Value="White"/></DataTrigger>
      <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="False"><Setter Property="Text" Value="KAPALI"/><Setter Property="Foreground" Value="#1C2126"/></DataTrigger>
     </Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
  </Grid>
 </Border>
</UserControl>
