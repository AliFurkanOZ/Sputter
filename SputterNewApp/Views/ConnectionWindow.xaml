<Window x:Class="SputterNewApp.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cihaz Bağlantısı" Style="{StaticResource AppWindow}" Width="560" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource TopBarBrush}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="SPUTTER CONTROL" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TopBarTextBrush}"/>
                <TextBlock Text="Cihaz bağlantısı" FontSize="12" Foreground="{StaticResource TopBarMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Kapat" Click="CloseWindow" IsCancel="True" Style="{StaticResource ToolButton}"/>
                <Button x:Name="btnConnect" Content="⚡ Bağlan" Click="OnConnectClicked" Style="{StaticResource ActionButton}" MinWidth="110" Margin="0"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="20,16">
            <GroupBox Header="Modbus TCP (PLC)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kayıt numarası" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtRegistrationNo" Grid.Column="1" Text="1234"/>
                    <TextBlock Grid.Row="1" Text="IP adresi" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtIpAddress" Grid.Row="1" Grid.Column="1" Text="192.168.1.5"/>
                    <TextBlock Grid.Row="2" Text="Port" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPort" Grid.Row="2" Grid.Column="1" Text="502" Width="100" HorizontalAlignment="Left" Style="{StaticResource NumericInput}"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="QCM Sensörleri (STM-2 COM Port)" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="DC:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQcmDcPort" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQcmDcStatus" Grid.Column="2" Text="Bağlı değil" Foreground="{StaticResource TopBarMutedBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="RF1:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQcmRf1Port" Grid.Row="1" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQcmRf1Status" Grid.Row="1" Grid.Column="2" Text="Bağlı değil" Foreground="{StaticResource TopBarMutedBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="RF2:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQcmRf2Port" Grid.Row="2" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQcmRf2Status" Grid.Row="2" Grid.Column="2" Text="Bağlı değil" Foreground="{StaticResource TopBarMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel>
                        <Button x:Name="btnScanQcm" Content="🔄 Portları Tara &amp; Bağlan" Click="OnScanQcmClicked" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtQcmScanResult" Text="" VerticalAlignment="Center" Foreground="{StaticResource TopBarMutedBrush}"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
            <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
                <DockPanel>
                    <Rectangle Style="{StaticResource StateLamp}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                    <TextBlock x:Name="txtStatus" Text="Bağlı değil" TextWrapping="Wrap" Style="{StaticResource FieldLabel}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
