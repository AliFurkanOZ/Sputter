       <!-- Dönen Çok Kanatlı Türbin Rotoru -->
       <Canvas Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform>
         <RotateTransform x:Name="TurboRotorTransform" Angle="0"/>
        </Canvas.RenderTransform>

        <!-- Kanatçıklar -->
        <Path Stroke="#1E293B" StrokeThickness="2.5" Data="M 24,4 L 24,44 M 4,24 L 44,24 M 10,10 L 38,38 M 10,38 L 38,10"/>
        <Ellipse Canvas.Left="18" Canvas.Top="18" Width="12" Height="12" Fill="#334155" Stroke="#CBD5E1" StrokeThickness="1.5"/>
       </Canvas>
      </Grid>
     </Border>
     <TextBlock Canvas.Left="910" Canvas.Top="452" Text="TURBO POMPA" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
     <TextBlock Canvas.Left="912" Canvas.Top="472" Text="{Binding State.TurboFrequency, StringFormat='{}{0} Hz'}" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>

     <!-- J. VENT VALFİ VE BASINÇ MANOMETRELERİ -->
     <!-- Hazne Basınç Sensörü (P1) -->
     <Ellipse Canvas.Left="311" Canvas.Top="70" Width="34" Height="34" Fill="#FFFFFF" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
     <TextBlock Canvas.Left="322" Canvas.Top="78" Text="P₁" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
     <TextBlock Canvas.Left="195" Canvas.Top="68" Text="Hazne basıncı" FontSize="11" Foreground="#475569"/>
     <Border Canvas.Left="195" Canvas.Top="84" Style="{StaticResource HudCard}">
      <TextBlock Text="{Binding State.Pressure, StringFormat='{}{0} Torr'}" FontSize="12.5" FontWeight="Bold" Foreground="#0284C7"/>
     </Border>

     <!-- Proses / Kapasitans Basınç Sensörü (Baratron P2) -->
     <Ellipse Canvas.Left="743" Canvas.Top="50" Width="34" Height="34" Fill="#FFFFFF" Stroke="{StaticResource Outline}" StrokeThickness="2"/>
     <TextBlock Canvas.Left="754" Canvas.Top="58" Text="P₂" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
     <TextBlock Canvas.Left="785" Canvas.Top="48" Text="Proses (Baratron)" FontSize="11" Foreground="#475569"/>
     <Border Canvas.Left="785" Canvas.Top="64" Style="{StaticResource HudCard}">
      <TextBlock Text="{Binding State.Capacitance, StringFormat='{}{0} Torr'}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B"/>
     </Border>

     <!-- V4 Vent Valfi -->
     <Path Canvas.Left="1022" Canvas.Top="185" Cursor="Hand" MouseDown="DeviceClick" Tag="110"
           Data="M 0,0 L 28,0 L 14,18 Z M 0,36 L 28,36 L 14,18 Z"
           ToolTip="V4 Hazne Vent Valfi (D110)">
      <Path.Style>
       <Style TargetType="Path" BasedOn="{StaticResource DynamicValveShape}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding State.VentValve.IsOpen}" Value="True">
          <Setter Property="Fill" Value="#10B981"/>
          <Setter Property="Stroke" Value="#059669"/>
         </DataTrigger>
         <DataTrigger Binding="{Binding State.VentValve.IsOpen}" Value="False">
          <Setter Property="Fill" Value="#FFFFFF"/>
          <Setter Property="Stroke" Value="#64748B"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Path.Style>
     </Path>
     <TextBlock Canvas.Left="976" Canvas.Top="120" Text="V4 Vent valfi" FontSize="11" Foreground="#475569"/>
     <c:ValveIndicator Canvas.Left="976" Canvas.Top="140" IsOpen="{Binding State.VentValve.IsOpen}"/>

    </Canvas>
   </Viewbox>
  </Border>
 </DockPanel>
</UserControl>
