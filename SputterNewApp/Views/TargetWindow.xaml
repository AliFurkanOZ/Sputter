<Window x:Class="SputterNewApp.Views.TargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target (Hedef Materyal) Yönetimi ve Seçimi"
        Style="{StaticResource AppWindow}"
        Width="840" Height="550" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowKeyDown">
    <DockPanel>
        <!-- Alt Onay ve Bilgi Çubuğu -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Vazgeç" IsCancel="True" Style="{StaticResource ToolButton}" MinWidth="95" Margin="0,0,10,0"/>
                    <Button x:Name="btnSelect" Content="✓ Seç ve Uygula" Click="SelectTarget" Style="{StaticResource ActionButton}" IsDefault="True" MinWidth="135" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="lblSelectionSummary" Text="Seçilen: —" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="lblStatusCount" Text="0 hedef materyal listeleniyor" Style="{StaticResource FieldLabel}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Üst Başlık ve Filtre Çubuğu -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Başlık ve Aktif Kaynak Rozeti -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" x:Name="ActiveSourceBadge" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hedef Kaynak: " FontSize="12" Foreground="{StaticResource LabelBrush}"/>
                            <TextBlock x:Name="lblActiveSource" Text="Tümü" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Target (Hedef Materyal) Listesi ve Yönetimi" Style="{StaticResource PageTitle}" FontSize="17"/>
                        <TextBlock Text="Katotlara takılı hedef materyalleri yönetin, ömürlerini izleyin veya kaynağa atayın." Style="{StaticResource PageSubtitle}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>

                <!-- Filtre ve CRUD İşlem Araç Çubuğu -->
                <DockPanel Grid.Row="1">
                    <!-- Sağ: Ekle, Düzenle, Sil, Ömrü Sıfırla -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="btnAdd" Click="OnAddTargetClicked" Style="{StaticResource SuccessToolButton}" Margin="0,0,6,0" ToolTip="Yeni bir hedef materyal (target) oluştur">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+ " FontWeight="Bold"/>
                                <TextBlock Text="Target Ekle"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnEdit" Click="OnEditTargetClicked" Style="{StaticResource ToolButton}" Margin="0,0,6,0" ToolTip="Seçili hedef materyalin bilgilerini düzenle (F2)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✎ "/>
                                <TextBlock Text="Düzenle"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnDelete" Click="OnDeleteTargetClicked" Style="{StaticResource DangerToolButton}" Margin="0,0,6,0" ToolTip="Seçili hedef materyali sil (Del)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕ "/>
                                <TextBlock Text="Sil"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnResetWh" Click="OnResetLifeClicked" Style="{StaticResource ToolButton}" ToolTip="Seçili target için kullanılan Wh ömrünü 0.00 yap">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺ "/>
                                <TextBlock Text="Ömrü Sıfırla"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sol: Kaynak Filtresi ve Anlık Arama -->
                    <DockPanel>
                        <TextBlock Text="Kaynak:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cbSourceFilter" Width="105" SelectionChanged="OnSourceFilterChanged" Margin="0,0,14,0" VerticalAlignment="Center" Height="26">
                            <ComboBoxItem Content="Tümü"/>
                            <ComboBoxItem Content="DC"/>
                            <ComboBoxItem Content="RF1"/>
                            <ComboBoxItem Content="RF2"/>
                            <ComboBoxItem Content="— (Boş)"/>
                        </ComboBox>

                        <TextBlock Text="Ara:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtSearch" TextChanged="OnSearchTextChanged" VerticalContentAlignment="Center" Height="26" Padding="6,0" ToolTip="Target adı veya kaynağa göre anlık arama yapın"/>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Ana Target Tablosu -->
        <GroupBox Header="Kayıtlı Hedef Materyaller" Margin="18,12">
            <DataGrid x:Name="TargetsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="30"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✓ Bu Target'ı Seç ve Kaynağa Ata" Click="SelectTarget" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem Header="+ Yeni Target Ekle..." Click="OnAddTargetClicked"/>
                        <MenuItem Header="✎ Seçili Target'ı Düzenle..." Click="OnEditTargetClicked"/>
                        <MenuItem Header="↺ Kullanılan Ömrü Sıfırla (0.00 Wh)" Click="OnResetLifeClicked"/>
                        <Separator/>
                        <MenuItem Header="✕ Seçili Target'ı Sil" Click="OnDeleteTargetClicked" Foreground="#B91C1C"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Target / Materyal Adı" Binding="{Binding Name}" Width="2*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Atanmış Kaynak" Binding="{Binding Source}" Width="1.2*" MinWidth="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Kullanılan Ömür (Wh)" Binding="{Binding UsedWh}" Width="1.6*" MinWidth="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0,12,0"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DockPanel>
</Window>
